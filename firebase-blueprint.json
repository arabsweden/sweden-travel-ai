{
  "entities": {
    "Itinerary": {
      "title": "Itinerary",
      "description": "A travel itinerary saved by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the itinerary" },
        "userId": { "type": "string", "description": "The UID of the user who owns this itinerary" },
        "title": { "type": "string", "description": "The custom title of the itinerary" },
        "departureCountry": { "type": "string", "description": "Departure country" },
        "startDate": { "type": "string", "description": "Start date of travel" },
        "endDate": { "type": "string", "description": "End date of travel" },
        "budget": { "type": "string", "description": "Selected travel budget tier" },
        "travelStyle": { "type": "string", "description": "Travel style tag" },
        "preferredCities": { "type": "array", "description": "List of cities included" },
        "itineraryDays": { "type": "array", "description": "The day-by-day travel details" },
        "estimatedCosts": { "type": "object", "description": "Calculated costs break down" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when created" }
      },
      "required": ["userId", "title", "itineraryDays"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "An attraction, city, or restaurant saved as favorite by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "itemType": { "type": "string", "enum": ["city", "attraction", "hotel", "restaurant"] },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "itemImage": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "itemType", "itemId", "itemName"]
    },
    "Destination": {
      "title": "Destination",
      "description": "An admin-managed Swedish city guide",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "topAttractions": { "type": "array" },
        "museums": { "type": "array" },
        "nature": { "type": "array" },
        "shopping": { "type": "array" },
        "restaurants": { "type": "array" },
        "transportation": { "type": "array" },
        "bestHotels": { "type": "array" },
        "nightlife": { "type": "array" },
        "localFood": { "type": "array" },
        "walkingRoutes": { "type": "array" },
        "familyActivities": { "type": "array" }
      },
      "required": ["name", "description"]
    },
    "HotelPartner": {
      "title": "HotelPartner",
      "description": "An admin-managed hotel partner recommendation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "city": { "type": "string" },
        "name": { "type": "string" },
        "stars": { "type": "number" },
        "pricePerNight": { "type": "number" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "amenities": { "type": "array" },
        "bookingUrl": { "type": "string" }
      },
      "required": ["city", "name", "pricePerNight"]
    },
    "RestaurantPartner": {
      "title": "RestaurantPartner",
      "description": "An admin-managed restaurant recommendation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "city": { "type": "string" },
        "name": { "type": "string" },
        "cuisine": { "type": "string" },
        "isHalal": { "type": "boolean" },
        "isVegetarian": { "type": "boolean" },
        "priceRange": { "type": "string" },
        "rating": { "type": "number" },
        "image": { "type": "string" },
        "address": { "type": "string" },
        "bookingUrl": { "type": "string" }
      },
      "required": ["city", "name", "cuisine"]
    },
    "TravelArticle": {
      "title": "TravelArticle",
      "description": "An admin-published travel article/news block",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "category"]
    },
    "Analytics": {
      "title": "Analytics",
      "description": "System analytics logged dynamically",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actionType": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "meta": { "type": "object" }
      },
      "required": ["actionType", "timestamp"]
    },
    "Checklist": {
      "title": "Checklist",
      "description": "A persistent travel preparation checklist synced with travel dates and weather context",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "weatherContext": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items"]
    }
  },
  "firestore": {
    "/itineraries/{itineraryId}": {
      "schema": "Itinerary",
      "description": "Collection of custom itineraries planned and saved by users"
    },
    "/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "Collection of user-favorited items"
    },
    "/destinations/{destinationId}": {
      "schema": "Destination",
      "description": "Admin managed Swedish city guides"
    },
    "/hotels/{hotelId}": {
      "schema": "HotelPartner",
      "description": "Admin managed hotel partners"
    },
    "/restaurants/{restaurantId}": {
      "schema": "RestaurantPartner",
      "description": "Admin managed restaurant partners"
    },
    "/travel_articles/{articleId}": {
      "schema": "TravelArticle",
      "description": "Admin published travel guides and articles"
    },
    "/analytics/{analyticsId}": {
      "schema": "Analytics",
      "description": "Dynamic app analytics"
    },
    "/checklists/{checklistId}": {
      "schema": "Checklist",
      "description": "Collection of user-managed preparation checklists"
    }
  }
}
